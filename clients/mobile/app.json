{
  "expo": {
    "name": "Nod",
    "slug": "nod-mobile",
    "scheme": "nod",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.gandreini.nod",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "7"
    },
    "android": {
      "package": "com.gandreini.nod",
      "adaptiveIcon": {
        "backgroundColor": "#fafafa",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "backgroundColor": "#fafafa",
          "dark": {
            "backgroundColor": "#191919"
          }
        }
      ],
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "Nod uses the microphone when you record a voice message or talk with Nod in a call."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Nod uses your photos when you attach them to a message.",
          "cameraPermission": "Nod uses the camera when you take a photo to attach to a message."
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#ff91ac",
          "defaultChannel": "messages"
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ]
  }
}
