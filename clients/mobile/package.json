{
  "name": "nod-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.2",
    "@elevenlabs/react-native": "^1.2.42",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@formatjs/intl-getcanonicallocales": "^3.3.1",
    "@formatjs/intl-locale": "^5.4.3",
    "@livekit/react-native": "^3.2.0",
    "@livekit/react-native-expo-plugin": "^1.2.0",
    "@livekit/react-native-webrtc": "^150.2.0",
    "expo": "~58.0.25",
    "expo-audio": "~58.0.12",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "livekit-client": "^2.24.1",
    "lucide-react-native": "^1.72.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-marked": "^8.3.4",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-sse": "1.2.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "../../node_modules/.bin/tsx --test tests/*.test.ts",
    "fake-server": "../../node_modules/.bin/tsx tool/fake-server.mts",
    "demo:server": "NOD_DEMO=1 ../../node_modules/.bin/tsx tool/fake-server.mts",
    "android:release": "expo prebuild --platform android --no-install --clean && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=arm64-v8a",
    "android:dev": "APP_VARIANT=development expo prebuild --platform android --no-install --clean && cd android && ./gradlew :app:assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "android:e2e": "APP_VARIANT=e2e expo prebuild --platform android --no-install --clean && cd android && ./gradlew :app:assembleRelease -PreactNativeArchitectures=${E2E_ABI:-arm64-v8a}",
    "ios:e2e": "APP_VARIANT=e2e expo prebuild --platform ios --no-install --clean && cd ios && pod install && xcodebuild -workspace NodE2E.xcworkspace -scheme NodE2E -configuration Release -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build ARCHS=arm64 -quiet",
    "ios:release": "expo prebuild --platform ios --no-install --clean && cd ios && pod install && xcodebuild -workspace Nod.xcworkspace -scheme Nod -configuration Release -destination 'generic/platform=iOS' -archivePath build/Nod.xcarchive -allowProvisioningUpdates DEVELOPMENT_TEAM=$APPLE_TEAM_ID CODE_SIGN_STYLE=Automatic archive -quiet",
    "ios:upload": "xcodebuild -exportArchive -archivePath ios/build/Nod.xcarchive -exportOptionsPlist export-options.plist -exportPath ios/build/export -allowProvisioningUpdates",
    "e2e": "e2e/run.sh",
    "e2e:ios": "E2E_PLATFORM=ios e2e/run.sh",
    "lint": "expo lint"
  },
  "private": true
}
